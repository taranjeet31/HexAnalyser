{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hex Analyser",
  "version": "1.0.0",
  "identifier": "com.hexanalyser.app",
  "build": {
    "frontendDist": "../tauri-frontend",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": "cp ../index.html ../tauri-frontend/index.html"
  },
  "app": {
    "windows": [
      {
        "title": "Hex Analyser",
        "width": 1120,
        "height": 840,
        "minWidth": 900,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
